---
import "../styles/global.css";
import { getCollection } from 'astro:content';
import SearchPosts from '../components/SearchPosts.vue'; // <-- Import the Vue island

// Fetch all posts, sorted by publish date descending
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <title>My Blog Index</title>
  </head>
  <body class="bg-slate-50 text-slate-900 h-full flex flex-col justify-between font-sans antialiased">
    
    <!-- Centered main wrapper -->
    <main class="max-w-2xl w-full mx-auto px-6 py-16 flex-1">
      
      <!-- Header section -->
      <header class="mb-10 text-center">
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Latest Articles</h1>
        <p class="text-slate-500 text-sm mt-2">Thoughts, tutorials, and insights built with Astro & Vue.</p>
      </header>
      
      <!-- VUE ISLAND: Passes static server-loaded posts into a reactive client search component -->
      <SearchPosts client:load posts={sortedPosts} />

    </main>

    <!-- Simple footer -->
    <footer class="py-6 text-center text-xs text-slate-400 border-t border-slate-200/60">
      &copy; {new Date().getFullYear()} Mario and Raoul. All rights reserved.
    </footer>
  </body>
</html>